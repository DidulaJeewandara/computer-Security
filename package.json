{
  "name": "deltaforce-mfa",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node tests/platform/scaffold.test.mjs && vitest run",
    "dev": "pnpm -r --parallel dev"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "typescript-eslint": "8.46.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "@types/node": "22.18.12",
    "yaml": "2.8.1"
  }
}
