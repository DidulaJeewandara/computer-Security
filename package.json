{
  "name": "deltaforce-mfa",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node tests/udk/p0-udk-1/scaffold.test.mjs && vitest run",
    "test:udk": "node tests/udk/p0-udk-1/scaffold.test.mjs && vitest run tests/udk",
    "dev": "pnpm -r --parallel dev",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file=.env node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "test:integration": "UDK_INTEGRATION=1 node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run tests/udk/p1-udk-1/database.integration.test.ts",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "typescript-eslint": "8.46.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "@types/node": "22.18.12",
    "yaml": "2.8.1",
    "prisma": "6.19.0",
    "tsx": "4.20.6",
    "@prisma/client": "6.19.0",
    "argon2": "0.44.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "argon2",
      "esbuild"
    ]
  }
}
