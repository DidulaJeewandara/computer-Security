# Development only. Supply your own credentials; never commit .env.
POSTGRES_USER=deltaforce
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=deltaforce
DATABASE_URL=postgresql://deltaforce:replace-with-local-password@localhost:5432/deltaforce
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=https://localhost:5173
TLS_CERT_FILE=keys/auth.deltaforce.lk.pem
TLS_KEY_FILE=keys/auth.deltaforce.lk-key.pem
# Generate with: openssl rand -hex 32 (required for sensitive database fields)
DATA_ENCRYPTION_KEY=
HOST=127.0.0.1
PORT=8443
NODE_ENV=development
# Seed only; password required explicitly, with no default
SEED_USERNAME=demo
SEED_PASSWORD=
